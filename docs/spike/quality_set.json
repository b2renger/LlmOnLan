      "prompt": "Write a Python function business_days(start, end) that takes two ISO dates as strings ('YYYY-MM-DD'), with end on or after start, and returns how many dates d with start <= d < end fall on Monday to Friday.",
      "reference": [
        "import datetime",
        "def business_days(start, end):",
        "    d = datetime.date.fromisoformat(start)",
        "    e = datetime.date.fromisoformat(end)",
