      "id": "code_merge_intervals", "kind": "code",
      "prompt": "Write a Python function merge_intervals(intervals) that takes a list of [start, end] pairs (in any order) and returns a list of merged, non-overlapping [start, end] pairs sorted by start. Intervals that touch (one ends where the next starts) must be merged.",
      "reference": [
        "def merge_intervals(intervals):",
        "    out = []",
        "    for a, b in sorted(intervals):",
        "        if out and a <= out[-1][1]:",
        "            out[-1][1] = max(out[-1][1], b)",
        "        else:",
        "            out.append([a, b])",
        "    return out"
      ],
      "tests": [
        "norm = lambda r: [list(x) for x in r]",
        "assert norm(merge_intervals([[1, 3], [2, 6], [8, 10], [15, 18]])) == [[1, 6], [8, 10], [15, 18]]",
        "assert norm(merge_intervals([[1, 4], [4, 5]])) == [[1, 5]]",
        "assert norm(merge_intervals([])) == []",
        "assert norm(merge_intervals([[5, 7], [1, 2], [2, 3]])) == [[1, 3], [5, 7]]",
        "assert norm(merge_intervals([[1, 10], [2, 3], [4, 12]])) == [[1, 12]]"
