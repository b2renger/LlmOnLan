      "id": "code_rle", "kind": "code",
      "prompt": "Write two Python functions: rle_encode(s) turns a string of letters into run-length form where each run is written as its count followed by the letter (for example 'aaabccdddd' becomes '3a1b2c4d', and twelve 'a' become '12a'); rle_decode(s) reverses it. The empty string encodes to the empty string.",
      "reference": [
        "def rle_encode(s):",
        "    out, i = [], 0",
        "    while i < len(s):",
        "        j = i",
        "        while j < len(s) and s[j] == s[i]:",
        "            j += 1",
        "        out.append(str(j - i) + s[i])",
        "        i = j",
        "    return ''.join(out)",
        "def rle_decode(s):",
        "    out, num = [], ''",
        "    for ch in s:",
        "        if ch.isdigit():",
        "            num += ch",
        "        else:",
        "            out.append(ch * int(num))",
        "            num = ''",
        "    return ''.join(out)"
      ],
      "tests": [
        "assert rle_encode('aaabccdddd') == '3a1b2c4d'",
        "assert rle_encode('') == ''",
        "assert rle_encode('a' * 12 + 'b') == '12a1b'",
        "assert rle_encode('abc') == '1a1b1c'",
        "assert rle_decode('3a1b2c4d') == 'aaabccdddd'",
        "assert rle_decode('12a1b') == 'a' * 12 + 'b'",
        "assert rle_decode('') == ''",
        "for t in ['zzzzzzzzzzzzzzzyx', 'q', 'aabbaabb']:",
        "    assert rle_decode(rle_encode(t)) == t"
      ]
    },
