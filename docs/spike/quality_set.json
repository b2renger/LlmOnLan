      "id": "code_topo_sort", "kind": "code",
      "prompt": "Write a Python function topo_sort(deps) where deps is a dict mapping each node (a string) to a list of the nodes it depends on. Nodes that appear only as dependencies are nodes too. Return a list of all nodes, each exactly once, in which every dependency comes before the nodes that depend on it. Raise ValueError if there is a cycle.",
      "reference": [
        "def topo_sort(deps):",
        "    nodes = set(deps) | {p for ps in deps.values() for p in ps}",
        "    state, out = {}, []",
        "    def visit(n):",
        "        if state.get(n) == 1:",
        "            raise ValueError('cycle')",
        "        if state.get(n) == 2:",
        "            return",
        "        state[n] = 1",
        "        for p in deps.get(n, []):",
        "            visit(p)",
        "        state[n] = 2",
        "        out.append(n)",
        "    for n in sorted(nodes):",
        "        visit(n)",
        "    return out"
      ],
      "tests": [
        "def check(deps, order):",
        "    order = list(order)",
        "    pos = {n: i for i, n in enumerate(order)}",
        "    nodes = set(deps) | {p for ps in deps.values() for p in ps}",
        "    assert set(order) == nodes and len(order) == len(nodes)",
        "    for n, ps in deps.items():",
        "        for p in ps:",
        "            assert pos[p] < pos[n]",
        "    return True",
        "d1 = {'app': ['lib', 'utils'], 'lib': ['utils', 'core'], 'utils': ['core'], 'core': []}",
        "assert check(d1, topo_sort(d1))",
        "d2 = {'a': ['b'], 'c': []}",
        "assert check(d2, topo_sort(d2))",
        "ok = False",
        "try:",
        "    topo_sort({'a': ['b'], 'b': ['c'], 'c': ['a']})",
        "except ValueError:",
        "    ok = True",
        "assert ok",
        "assert list(topo_sort({})) == []"
      ]
    },
