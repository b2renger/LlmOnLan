      "id": "code_parse_duration", "kind": "code",
      "prompt": "Write a Python function parse_duration(s) that parses durations like '1h30m', '45s', '2h', '1h0m5s' or '90m' into a total number of seconds (int). The units h, m and s may each appear at most once, in that order, and each must be preceded by a non-negative integer. Surrounding whitespace is allowed. Raise ValueError for an empty string, an unknown character, a number without a unit, or units that are repeated or out of order.",
      "reference": [
        "def parse_duration(s):",
        "    s = s.strip()",
        "    if not s:",
        "        raise ValueError('empty')",
        "    mult = {'h': 3600, 'm': 60, 's': 1}",
        "    order = 'hms'",
        "    total, num, last = 0, '', -1",
        "    for ch in s:",
        "        if ch.isdigit():",
        "            num += ch",
        "        elif ch in mult and num:",
        "            idx = order.index(ch)",
        "            if idx <= last:",
        "                raise ValueError('order')",
        "            last = idx",
        "            total += int(num) * mult[ch]",
        "            num = ''",
        "        else:",
        "            raise ValueError('bad')",
        "    if num:",
        "        raise ValueError('no unit')",
        "    return total"
      ],
      "tests": [
        "def raises(f, *a):",
        "    try:",
        "        f(*a)",
        "    except ValueError:",
        "        return True",
        "    except Exception:",
        "        return False",
        "    return False",
        "assert parse_duration('1h30m') == 5400",
        "assert parse_duration('45s') == 45",
        "assert parse_duration('2h') == 7200",
        "assert parse_duration('1h0m5s') == 3605",
        "assert parse_duration(' 90m ') == 5400",
        "assert raises(parse_duration, '')",
        "assert raises(parse_duration, 'abc')",
        "assert raises(parse_duration, '10')",
        "assert raises(parse_duration, '5m1h')",
        "assert raises(parse_duration, '1h1h')"
      ]
