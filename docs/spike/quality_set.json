      "id": "code_eval_expr", "kind": "code",
      "prompt": "Write a Python function eval_expr(s) that evaluates an arithmetic expression string containing non-negative integer or decimal numbers, +, -, *, /, parentheses, unary minus and spaces, with the usual precedence and left-to-right associativity, and returns the result as a number. Do not use eval, exec or any other code-execution shortcut; write the parser yourself.",
      "reference": [
        "def eval_expr(s):",
        "    toks = []",
        "    i = 0",
        "    while i < len(s):",
        "        c = s[i]",
        "        if c.isspace():",
        "            i += 1",
        "        elif c.isdigit() or c == '.':",
        "            j = i",
        "            while j < len(s) and (s[j].isdigit() or s[j] == '.'):",
        "                j += 1",
        "            toks.append(float(s[i:j]))",
        "            i = j",
        "        elif c in '+-*/()':",
        "            toks.append(c)",
        "            i += 1",
        "        else:",
        "            raise ValueError(c)",
        "    pos = [0]",
        "    def peek():",
        "        return toks[pos[0]] if pos[0] < len(toks) else None",
        "    def take():",
        "        t = toks[pos[0]]",
        "        pos[0] += 1",
        "        return t",
        "    def expr():",
        "        v = term()",
        "        while peek() in ('+', '-'):",
        "            op = take()",
        "            r = term()",
        "            v = v + r if op == '+' else v - r",
        "        return v",
        "    def term():",
        "        v = factor()",
        "        while peek() in ('*', '/'):",
        "            op = take()",
        "            r = factor()",
        "            v = v * r if op == '*' else v / r",
        "        return v",
        "    def factor():",
        "        t = peek()",
        "        if t == '-':",
        "            take()",
        "            return -factor()",
        "        if t == '+':",
        "            take()",
        "            return factor()",
        "        if t == '(':",
        "            take()",
        "            v = expr()",
        "            take()",
        "            return v",
        "        return take()",
        "    v = expr()",
        "    if pos[0] != len(toks):",
        "        raise ValueError('trailing')",
        "    return v"
      ],
      "tests": [
        "import builtins",
        "builtins.eval = None",
        "builtins.exec = None",
        "close = lambda a, b: abs(a - b) < 1e-9",
        "assert close(eval_expr('1 + 2 * 3'), 7)",
        "assert close(eval_expr('(1 + 2) * 3'), 9)",
        "assert close(eval_expr('-4 + 10 / 4'), -1.5)",
        "assert close(eval_expr('2 * (3 + (4 - 1)) / -3'), -4)",
        "assert close(eval_expr('  7  '), 7)",
        "assert close(eval_expr('1.5 * -(2 - 4)'), 3)",
        "assert close(eval_expr('10 - 2 - 3'), 5)",
        "assert close(eval_expr('2 * 3 / 4 * 2'), 3)"
      ]
    },
