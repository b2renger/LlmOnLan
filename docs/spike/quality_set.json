      "id": "code_palindrome", "kind": "code",
      "prompt": "Write a Python function longest_palindrome(s) that returns the longest palindromic substring of s. If several have the maximum length, return the one that starts first. Return '' for an empty string.",
      "reference": [
        "def longest_palindrome(s):",
        "    best = ''",
        "    for i in range(len(s)):",
        "        for lo, hi in ((i, i), (i, i + 1)):",
        "            while lo >= 0 and hi < len(s) and s[lo] == s[hi]:",
        "                lo -= 1",
        "                hi += 1",
        "            cand = s[lo + 1:hi]",
        "            if len(cand) > len(best):",
        "                best = cand",
        "    return best"
      ],
      "tests": [
        "assert longest_palindrome('babad') == 'bab'",
        "assert longest_palindrome('cbbd') == 'bb'",
        "assert longest_palindrome('a') == 'a'",
        "assert longest_palindrome('forgeeksskeegfor') == 'geeksskeeg'",
        "assert longest_palindrome('') == ''",
        "assert longest_palindrome('abacdfgdcaba') == 'aba'"
      ]
    },
