      "id": "code_roman", "kind": "code",
      "prompt": "Write a Python function roman_to_int(s) that converts a valid Roman numeral string (I, V, X, L, C, D, M, with subtractive pairs like IV, IX, XL, XC, CD, CM) into an int.",
      "reference": [
        "def roman_to_int(s):",
        "    v = {'I': 1, 'V': 5, 'X': 10, 'L': 50, 'C': 100, 'D': 500, 'M': 1000}",
        "    total = 0",
        "    for i, ch in enumerate(s):",
        "        if i + 1 < len(s) and v[ch] < v[s[i + 1]]:",
        "            total -= v[ch]",
        "        else:",
        "            total += v[ch]",
        "    return total"
      ],
      "tests": [
        "assert roman_to_int('III') == 3",
        "assert roman_to_int('LVIII') == 58",
        "assert roman_to_int('MCMXCIV') == 1994",
        "assert roman_to_int('MMXXVI') == 2026",
        "assert roman_to_int('XLIX') == 49",
        "assert roman_to_int('CDXLIV') == 444"
      ]
    },
