{
  "name": "llmonlan-farm-app",
  "version": "0.0.18",
  "description": "LlmOnLan Farm — a self-installing desktop app that turns a GPU box into a running farm (bundled Ollama + Python + the lol server) with zero terminal.",
  "license": "MIT",
  "author": "b2renger",
  "private": true,
  "main": "build/main/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "pack": "npm run build && electron-builder --dir",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.7.2"
  }
}
